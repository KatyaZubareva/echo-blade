        <ui:VisualElement name="Sidebar" style="flex-grow: 1; position: absolute; left: 75%; top: 20%; bottom: 50%; right: 5%; align-content: auto; justify-content: flex-end;">
            <ui:Label text="Label" />
            <ui:Label text="Label" />
            <ui:Label text="Label" />
            <ui:Label text="Label" />
