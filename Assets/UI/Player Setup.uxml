        <ui:VisualElement name="CardsContainer" style="flex-grow: 1; flex-direction: row; justify-content: center; align-content: center; margin-top: 0%; padding-top: 30%; padding-bottom: 5%; background-color: rgba(0, 0, 0, 0); height: 90%;">
            <ui:Button text="Персонаж 1" name="Card" />
